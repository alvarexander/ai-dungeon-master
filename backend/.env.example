# =====================================================================
# .env.example — a template for your local configuration
# =====================================================================
#
# WHAT AN ENVIRONMENT VARIABLE IS
# A setting that lives outside the code, supplied by whatever launches the
# program. It exists so that secrets (like your Gemini key) and things that
# differ between your laptop and the real server (like web addresses) are
# never written into files that get committed to version control.
#
# WHAT TO DO WITH THIS FILE
#   1. Copy it:            cp .env.example .env
#   2. Fill in the values marked CHANGE ME below.
#   3. Never commit .env. It is already listed in .gitignore.
#
# The analogy: .env.example is the blank form; .env is your filled-in copy.
# The blank form is shared so everyone knows which questions to answer. Your
# filled-in copy has your answers on it and stays on your desk.
# =====================================================================


# ---------------------------------------------------------------------
# 1. ENVIRONMENT
# ---------------------------------------------------------------------
# One of: local, staging, production.
# This is not cosmetic. When set to "production" the application REFUSES to
# start if any insecure development setting is still in place — see
# ENCRYPTION_PROVIDER below. That refusal is deliberate: it is far better to
# fail loudly at startup than to run in production with a development key.
APP_ENV=local

# The name shown in the Swagger documentation page heading.
APP_NAME=AI Dungeon Master API


# ---------------------------------------------------------------------
# 2. NETWORK ADDRESSES
# ---------------------------------------------------------------------
# CORS (Cross-Origin Resource Sharing) is a browser rule. A web page loaded
# from one address is not allowed to read replies from a different address
# unless that other address explicitly permits it. Because the Angular app and
# this backend run on different addresses, this backend has to name the
# frontend here or every request from the browser will be blocked.
#
# Comma-separated. No trailing slash. Must match EXACTLY, including the port.
# In production this becomes your real domain, e.g. https://app.example.com
CORS_ALLOWED_ORIGINS=http://localhost:4200

# The address this server listens on locally.
HOST=127.0.0.1
PORT=8000


# ---------------------------------------------------------------------
# 3. GOOGLE GEMINI  ← CHANGE ME
# ---------------------------------------------------------------------
# Your API key. An API key is like a house key: whoever holds it can use your
# account. Anyone with this string can spend your quota and, on a paid plan,
# your money.
#
# Get one from Google AI Studio — step-by-step instructions with descriptions
# of what each page looks like are in docs/GEMINI.md.
#
# THIS KEY MUST NEVER REACH THE BROWSER. Every Gemini call happens here, on
# the server. There is no configuration in the Angular app that accepts it.
GEMINI_API_KEY=CHANGE_ME_paste_your_key_here

# Which model to use. gemini-3.5-flash is stable, free-tier eligible, and
# tuned for exactly this kind of high-volume conversational workload.
# To check which models YOUR key can actually reach, run:
#   uv run python scripts/check_gemini_models.py
GEMINI_MODEL_ID=gemini-3.5-flash

# The Gemini service address. Lives here rather than in code so that the SSRF
# allowlist and the client agree on one source of truth.
GEMINI_BASE_URL=https://generativelanguage.googleapis.com

# How long to wait for a reply before giving up, and how many times to retry
# a failure that looks temporary.
# A reply normally takes two to six seconds. Thirty is generous; past that
# something is wrong rather than slow. Timeouts are NOT retried — retrying
# one only makes the player wait the same length of time again.
GEMINI_TIMEOUT_SECONDS=30
GEMINI_MAX_RETRIES=2

# Remove things that look like personal data from prompts before they leave
# this server. Google's free tier terms permit them to use your prompts to
# improve their products, and state that human reviewers may read them, so
# this is strongly recommended. See docs/GEMINI.md.
SCRUB_OUTBOUND_PROMPTS=true


# ---------------------------------------------------------------------
# 4. ENCRYPTION
# ---------------------------------------------------------------------
# Which key service protects user data.
#   local   — a fixed development key held in this file. Data is genuinely
#             encrypted, but with a key that is written down right here, so it
#             offers no real protection. Perfect for local work, because you
#             can inspect anything. The application logs a loud warning at
#             startup and REFUSES to run this way when APP_ENV=production.
#   aws_kms — the real thing. Keys live in AWS hardware and never leave it.
ENCRYPTION_PROVIDER=local

# The development master key: 32 random bytes, base64 encoded.
# This value is published in a public example file, so it is not a secret and
# must never protect anything real. Generate your own with:
#   python3 -c "import os,base64; print(base64.b64encode(os.urandom(32)).decode())"
LOCAL_DEV_MASTER_KEY=ZGV2LW9ubHkta2V5LW5vdC1mb3ItcHJvZHVjdGlvbi0wMDAxIQ==

# Used only when ENCRYPTION_PROVIDER=aws_kms. Names the key; is not the key.
KMS_KEY_ARN=
KMS_AUDIT_KEY_ARN=
AWS_REGION=eu-west-2

# The key that turns an email address into a searchable fingerprint. It must
# NEVER be stored in the database — its absence there is what stops an
# attacker with a database dump from testing whether an address is registered.
# In production this comes from AWS Secrets Manager.
BLIND_INDEX_KEY=ZGV2LW9ubHktYmxpbmQtaW5kZXgta2V5LTAwMDAwMDAwMDE=

# The base secret for hashing IP addresses. A fresh salt is derived from this
# for each day and is never written down next to the digests, so yesterday's
# records cannot be matched against today's.
IP_HASH_SECRET=ZGV2LW9ubHktaXAtaGFzaC1zZWNyZXQtMDAwMDAwMDAwMDAx


# AUTHENTICATION MODE
#   stub — Phase 1. Registration, password hashing and the encrypted email
#          lookup are all genuinely implemented. What is NOT implemented is
#          the session: the token handed out is a placeholder, and anyone
#          presenting it is believed. That is deliberate for a local
#          prototype and completely unacceptable on a real server, so the
#          application refuses to start with it when APP_ENV=production.
#   real — Phase 2. Signed, expiring tokens.
AUTH_MODE=stub

# ---------------------------------------------------------------------
# 5. STORAGE
# ---------------------------------------------------------------------
# memory — everything is kept in the server's memory and vanishes on restart.
#          This is Phase 1. No database required.
# mysql  — Phase 2. The schema is fully designed in migrations/ but not wired.
REPOSITORY_BACKEND=memory

# Only used when REPOSITORY_BACKEND=mysql. TLS is not optional.
DATABASE_URL=
DATABASE_SSL_CA_PATH=


# ---------------------------------------------------------------------
# 6. XSRF PROTECTION
# ---------------------------------------------------------------------
# XSRF (Cross-Site Request Forgery) is an attack where a malicious website
# tricks a browser that is already logged in to your site into performing an
# action — submitting a form, deleting an account — without the user knowing.
# The defence: the server hands the browser a random token, and every
# state-changing request must echo it back in a header. The malicious site
# cannot read the token, so it cannot forge the header.
#
# These names are Angular's defaults. Change them only if you change Angular's
# configuration to match, or protection silently stops working.
XSRF_COOKIE_NAME=XSRF-TOKEN
XSRF_HEADER_NAME=X-XSRF-TOKEN

# Set to true in production so the browser only ever sends cookies over HTTPS.
# Must be false for local development, because local development is plain HTTP.
COOKIE_SECURE=false

# Which domain the XSRF cookie belongs to.
#
# READ THIS BEFORE DEPLOYING — it catches almost everyone.
# A browser will not let a page on one domain read a cookie set by a
# different domain. Locally that is fine: the Angular app is on
# localhost:4200 and this server is on localhost:8000, and cookies ignore
# port numbers, so they share cookies and this can stay empty.
#
# In production they are genuinely different hosts. For the Angular app to
# read the token this server sets, BOTH must sit under one parent domain
# and this must name it with a leading dot:
#     frontend  https://app.example.com   (Hostinger)
#     backend   https://api.example.com   (Fly.io)
#     COOKIE_DOMAIN=.example.com
#
# If the backend ends up on a fly.dev address instead of your own domain,
# cookie-based XSRF protection cannot work at all. See docs/SECURITY.md.
COOKIE_DOMAIN=


# ---------------------------------------------------------------------
# 7. RATE LIMITS
# ---------------------------------------------------------------------
# Format: <requests>/<seconds>. Reasoning for each number is in
# docs/SECURITY.md — these are not arbitrary.
RATE_LIMIT_IP_GLOBAL=300/60
RATE_LIMIT_LOGIN=5/900
RATE_LIMIT_REGISTER=3/3600
RATE_LIMIT_CHAT=20/60
RATE_LIMIT_STT=10/60
RATE_LIMIT_PASSWORD_RESET=3/3600


# ---------------------------------------------------------------------
# 8. VOICE INPUT (speech-to-text)
# ---------------------------------------------------------------------
# Transcription runs HERE, on this server, using a local model. Audio is never
# sent to Google or any other third party — that is the whole reason we do not
# use the browser's built-in speech recognition. See docs/VOICE_INPUT.md in
# the frontend repository and ADR-008.
STT_ENABLED=true

# Model size. Bigger is more accurate and slower.
#   tiny   ~75 MB   fast, adequate for short commands
#   base   ~145 MB  the recommended balance   ← default
#   small  ~480 MB  noticeably better, needs about 2 GB of memory
STT_MODEL_SIZE=base

# cpu, or cuda if you have an NVIDIA graphics card. Apple Macs use cpu.
STT_DEVICE=cpu
STT_COMPUTE_TYPE=int8

# Safety limits on uploads. An audio file is an untrusted input like any other.
STT_MAX_SECONDS=120
STT_MAX_UPLOAD_BYTES=10485760


# ---------------------------------------------------------------------
# 9. LOGGING AND TELEMETRY
# ---------------------------------------------------------------------
# json    — one JSON object per line. Use in production; machines read it.
# console — coloured and indented. Use locally; humans read it.
LOG_FORMAT=console
LOG_LEVEL=INFO

# The redaction filter works from an ALLOWLIST: any field not explicitly
# declared safe to log is replaced with a description of its type and length,
# such as <str:len=24>. Turning this off is only ever acceptable locally, and
# the application refuses to do it when APP_ENV=production.
LOG_REDACTION_ENABLED=true

# Error reporting. Leave blank to disable. send_default_pii is forced to False
# in code and cannot be overridden by configuration.
SENTRY_DSN=

# How long an opt-in debug capture of prompt content survives. Hard maximum.
DEBUG_CAPTURE_TTL_HOURS=48

# How long a support access grant lasts before it expires on its own.
SUPPORT_GRANT_TTL_SECONDS=3600
