# --- Secrets: never commit these ---
# A ".env" file holds configuration values that are private to your machine,
# such as your Gemini API key. Committing one publishes your key to anyone who
# can read the repository.
.env
.env.*
!.env.example

# --- Python ---
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage
dist/
build/
*.egg-info/

# --- Node / Angular ---
node_modules/
/frontend/dist/
/frontend/.angular/
/frontend/coverage/

# --- Editors and operating system junk ---
.DS_Store
.vscode/
*.swp

# --- JetBrains project files ---
#
# These ARE committed, so that anyone opening the project in PyCharm or
# WebStorm gets the run configurations, the code style and the inspection
# settings without setting them up by hand.
#
# The exceptions below are the per-user files. `workspace.xml` in particular
# holds your open tabs, window layout, local run history and — the reason it
# matters here — absolute paths containing your username. Sharing it would put
# your home directory in a public repository and cause a merge conflict every
# time two people opened the project.
.idea/workspace.xml
.idea/tasks.xml
.idea/usage.statistics.xml
.idea/dictionaries/
.idea/shelf/
.idea/httpRequests/
.idea/dataSources.local.xml
.idea/**/dataSources/
.idea/.DS_Store

# --- Local model caches (speech-to-text weights are large) ---
.cache/
models/
